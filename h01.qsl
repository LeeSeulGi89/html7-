// ====================================
// QSL 기본 구조 예제 - 초보자용
// ====================================

// 1. 변수 선언하기
// 변수는 데이터를 저장하는 공간입니다
var name = "홍길동";           // 문자열(텍스트) 저장
var age = 25;                  // 숫자 저장
var isStudent = true;          // 참/거짓 값 저장

// 2. 화면에 출력하기
// print 명령어로 결과를 화면에 표시합니다
print("안녕하세요!");          // 문자열 출력
print(name);                   // 변수 값 출력
print("나이: " + age);         // 문자열과 변수 연결해서 출력

// 3. 조건문 사용하기
// if문은 조건에 따라 다른 동작을 실행합니다
if (age >= 20) {
    print("성인입니다");       // 조건이 참일 때 실행
} else {
    print("미성년자입니다");   // 조건이 거짓일 때 실행
}

// 4. 반복문 사용하기
// for문은 같은 동작을 여러 번 반복합니다
print("1부터 5까지 출력:");
for (var i = 1; i <= 5; i++) {
    print(i);                  // i가 1부터 5까지 하나씩 증가하며 출력
}

// 5. 함수 정의하기
// 함수는 반복적으로 사용할 코드를 묶어놓은 것입니다
function greet(userName) {
    // userName을 받아서 인사 메시지를 반환
    return "안녕하세요, " + userName + "님!";
}

// 함수 호출하기
var message = greet("이순신");  // 함수 실행
print(message);                 // 결과 출력

// 6. 배열 사용하기
// 배열은 여러 개의 값을 하나의 변수에 저장합니다
var fruits = ["사과", "바나나", "오렌지"];

print("과일 목록:");
for (var j = 0; j < fruits.length; j++) {
    print((j + 1) + ". " + fruits[j]);  // 배열의 각 항목 출력
}

// 7. 객체 사용하기
// 객체는 관련된 데이터를 묶어서 저장합니다
var person = {
    name: "김철수",
    age: 30,
    job: "개발자"
};

print("\n사람 정보:");
print("이름: " + person.name);
print("나이: " + person.age);
print("직업: " + person.job);

// 8. 간단한 계산하기
var num1 = 10;
var num2 = 5;

print("\n계산 결과:");
print("더하기: " + (num1 + num2));      // 15
print("빼기: " + (num1 - num2));        // 5
print("곱하기: " + (num1 * num2));      // 50
print("나누기: " + (num1 / num2));      // 2

// ====================================
